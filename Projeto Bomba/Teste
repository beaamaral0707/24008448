#include <WiFi.h>
#include <WebServer.h>
#include <SPI.h>
#include <MFRC522.h>

// ===== CONFIG =====
const char* ssid = "SEU_SSID";
const char* password = "SUA_SENHA";

// Pinos do RC522 (ajuste conforme sua ligação)
#define RST_PIN 22
#define SS_PIN 5

// Tempo em ms que a autenticação permanece válida após leitura
const unsigned long AUTH_TIMEOUT = 30000; // 30 segundos

// ===== OBJETOS =====
MFRC522 mfrc522(SS_PIN, RST_PIN);
WebServer server(80);

// estado de autenticação
bool authenticated = false;
String authenticatedUID = "";
unsigned long authUntil = 0;

// ===== HTML da página (uma única página simples) =====
const char index_html[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>ESP32 RFID - Formulário</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
      body { font-family: Arial, sans-serif; padding: 20px; max-width: 600px; margin:auto; }
      .locked { opacity: 0.5; pointer-events: none; }
      label { display:block; margin-top:12px; }
      input, select, button { width:100%; padding:8px; margin-top:6px; box-sizing:border-box; }
      .status { margin-top:12px; font-weight:bold; }
    </style>
  </head>
  <body>
    <h2>ESP32 — Formulário após RFID</h2>
    <p>Aproxime o cartão RFID do leitor. Quando autenticado o formulário será liberado.</p>

    <div id="status" class="status">Verificando autenticação...</div>

    <form id="myForm" class="locked" onsubmit="submitForm(event)">
      <label>Nome:
        <input type="text" id="nome" required placeholder="Seu nome">
      </label>

      <label>Valor:
        <input type="text" id="valor" required placeholder="Digite um valor">
      </label>

      <label>Opção:
        <select id="opcao">
          <option value="A">Opção A</option>
          <option value="B">Opção B</option>
          <option value="C">Opção C</option>
        </select>
      </label>

      <button type="submit">Enviar</button>
    </form>

    <script>
      // Polling simples para verificar se o ESP32 já autenticou um UID
      async function checkAuth() {
        try {
          const resp = await fetch('/auth');
          const j = await resp.json();
          const status = document.getElementById('status');
          const form = document.getElementById('myForm');

          if (j.authenticated) {
            status.textContent = 'Autenticado! UID: ' + j.uid;
            form.classList.remove('locked');
          } else {
            status.textContent = 'Aguardando RFID...';
            form.classList.add('locked');
          }
        } catch (e) {
          document.getElementById('status').textContent = 'Erro ao verificar autenticação';
        }
      }

      setInterval(checkAuth, 1000);
      checkAuth();

      async function submitForm(ev) {
        ev.preventDefault();
        const data = {
          nome: document.getElementById('nome').value,
          valor: document.getElementById('valor').value,
          opcao: document.getElementById('opcao').value
        };

        const resp = await fetch('/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (resp.ok) {
          const r = await resp.json();
          alert('Servidor recebeu:\n' + JSON.stringify(r));
          // limpar campos se quiser
          document.getElementById('nome').value = '';
          document.getElementById('valor').value = '';
        } else {
          alert('Erro ao enviar ao servidor');
        }
      }
    </script>
  </body>
</html>
)rawliteral";

// ===== FUNÇÕES DO SERVIDOR =====
void handleRoot() {
  server.send_P(200, "text/html", index_html);
}

void handleAuth() {
  String payload = "{";
  payload += "\"authenticated\":";
  payload += (authenticated ? "true" : "false");
  payload += ",\"uid\":\"" + authenticatedUID + "\"";
  payload += "}";
  server.send(200, "application/json", payload);
}

void handleSubmit() {
  if (!server.hasArg("plain")) {
    server.send(400, "text/plain", "No body");
    return;
  }
  String body = server.arg("plain");
  // apenas ecoa o que recebeu
  Serial.println("=== SUBMIT RECEBIDO ===");
  Serial.println(body);
  server.send(200, "application/json", body);
}

// ===== SETUP =====
void setup() {
  Serial.begin(115200);
  delay(100);

  // Inicializa SPI e RC522
  SPI.begin(); // SCK MOSI MISO pelos pinos default do ESP32
  mfrc522.PCD_Init();
  Serial.println("Leitor RFID inicializado.");

  // Conecta na WiFi
  WiFi.mode(WIFI_STA);
  WiFi.begin(ssid, password);
  Serial.printf("Conectando a %s ...\n", ssid);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < 20000) {
    delay(500);
    Serial.print(".");
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.println("");
    Serial.print("Conectado! IP: ");
    Serial.println(WiFi.localIP());
  } else {
    // Se não conectar, cria um AP para debug
    Serial.println("\nFalha ao conectar, iniciando Access Point");
    WiFi.softAP("ESP32_RFID_AP");
    Serial.print("AP IP: ");
    Serial.println(WiFi.softAPIP());
  }

  // rotas
  server.on("/", HTTP_GET, handleRoot);
  server.on("/auth", HTTP_GET, handleAuth);
  server.on("/submit", HTTP_POST, handleSubmit);

  server.begin();
  Serial.println("Servidor HTTP iniciado.");
}

// ===== LOOP =====
void loop() {
  server.handleClient();

  // checar RFID
  if (mfrc522.PICC_IsNewCardPresent() && mfrc522.PICC_ReadCardSerial()) {
    // ler UID
    String uid = "";
    for (byte i = 0; i < mfrc522.uid.size; i++) {
      if (mfrc522.uid.uidByte[i] < 0x10) uid += "0";
      uid += String(mfrc522.uid.uidByte[i], HEX);
    }
    uid.toUpperCase();
    Serial.print("Cartão detectado! UID: ");
    Serial.println(uid);

    // Aqui você pode validar o UID com uma lista de UIDs válidos.
    // Para demo, autentica qualquer cartão.
    authenticated = true;
    authenticatedUID = uid;
    authUntil = millis() + AUTH_TIMEOUT;

    // descarrega a tag do buffer
    mfrc522.PICC_HaltA();
    mfrc522.PCD_StopCrypto1();
  }

  // se tempo expirou, resetar autenticação
  if (authenticated && millis() > authUntil) {
    authenticated = false;
    authenticatedUID = "";
  }

  // pequeno delay para evitar uso excessivo de CPU
  delay(10);
}
