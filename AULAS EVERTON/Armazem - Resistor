} Lista;

Lista* criarLista() { // cria uma nova lista
    Lista *li = malloc(sizeof(Lista)); // alocação de memória
    if (li != NULL)
        li->qtd = 0; //inicializa em 0
    return li; // retorna o ponteiro
}


int inserirResistor(Lista* li, Estoque al) {
    if (li == NULL) return 0;
    if (li->qtd == MAX) return 0;

    int i, k = 0;
    while (k < li->qtd && li->dados[k].resistencia < al.resistencia) {
        k++;
    }
    for (i = li->qtd - 1; i >= k; i--) {
        li->dados[i+1] = li->dados[i];
    }
    li->dados[k] = al;
    li->qtd++;
    return 1;
}
