
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>Simulador - ESP32 RFID Formulário</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

<style>
  body{font-family:Arial,Helvetica,sans-serif;max-width:700px;margin:30px auto;padding:10px}
  .locked{opacity:.5;pointer-events:none}
  /* Estilos básicos para campos */
  label{display:block;margin-top:12px}
  input,select,button{width:100%;padding:8px;margin-top:6px;box-sizing:border-box}
  .status{margin-top:12px;font-weight:bold; color: green;} 
  pre{background:#f4f4f4;padding:8px;border-radius:4px;white-space: pre-wrap;}
  
  /* Estilo customizado para o campo "Valor" */
  .input-with-label {
    display: flex;
    align-items: center;
    gap: 5px; 
    width: 100%;
  }
  .input-with-label input {
    flex-grow: 1;
    width: auto;
    margin-top: 0; 
  }
  .input-with-label span {
    padding: 8px 0;
    margin-top: 6px;
    font-weight: bold;
    white-space: nowrap;
    width: 25px;
  }
  
  /* Botões Superiores */
  .button-group {
      display: flex;
      gap: 8px;
      margin-bottom: 10px;
  }
  .button-group button {
      width: auto;
      flex-grow: 1;
      padding: 10px;
  }

  /* Login Manual - layout horizontal (mantido) */
  .login-form {
      border: 1px solid #ccc;
      padding: 15px;
      border-radius: 4px;
      margin-top: 20px;
      background: #eee;
  }
  #loginForm {
      display: flex;
      flex-direction: row; 
      gap: 10px;
      align-items: flex-end; 
  }
    #loginForm label {
        flex: 1;
        margin-top: 0;
    }
    #loginForm button {
        flex-basis: 120px;
        margin-top: 0;
    }
    #loginForm input {
        margin-top: 0;
    }


  /* 💥 FORMULÁRIO PRINCIPAL: Coluna Única Centralizada 💥 */
  #myForm {
      max-width: 450px; /* Reduz a largura máxima para dar aspecto de coluna */
      margin: 20px auto; /* Centraliza o formulário principal */
      padding: 0; /* Remove padding lateral */
  }
    
    /* Garante que todos os grupos ocupem a largura máxima da coluna */
    #myForm > div {
        margin-bottom: 15px;
        width: 100%;
    }

    /* Remove o agrupamento triplo para voltar à coluna única */
    .form-group-triple {
        display: block; 
        margin-bottom: 15px;
    }
    .form-group-triple > div {
        /* Garante que os campos fiquem na largura total da coluna */
        width: 100%; 
        margin-bottom: 15px;
    }
    .form-group-triple label {
        margin-top: 0;
    }

    /* Remove o estilo de centralização para ID da Bomba, voltando à esquerda */
    .form-group-row-center {
        display: block;
        margin-bottom: 20px;
    }
    .form-group-row-center > div {
        width: 100%;
        min-width: auto;
    }

    /* Campos de Entrada Individual (para Observação e Leito) - Agora padrão */
    .form-group-single {
        margin-bottom: 15px;
        width: 100%;
    }
    .form-group-single label {
        margin-top: 0;
    }


    /* Ajuste para o Fieldset - Estado da Bomba */
    #myForm fieldset {
        margin-bottom: 20px;
        padding: 10px 10px 5px 10px; 
        border: 1px solid #ccc; 
    }

    /* Estilo para o botão de envio */
    #myForm button[type="submit"] {
        display: block;
        margin: 20px auto; /* Centraliza o botão na base da coluna */
        max-width: 200px; 
        width: 100%;
    }

  /* Estilos para Radio Buttons dentro do Fieldset */
  .radio-group {
      display: flex;
      gap: 20px;
      margin-top: 10px;
  }
  .radio-group div {
      display: flex;
      align-items: center;
      gap: 5px;
  }
  .radio-group input[type="radio"] {
      width: auto; 
      margin-top: 0;
  }
  .radio-group label {
      display: inline;
      margin-top: 0;
      text-align: left;
  }

  /* Logs */
  .log-container {
    max-width: 650px; 
    margin: 20px auto; 
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
  }
  #log-output {
    max-height: 300px; 
    overflow-y: scroll; 
    border: 1px solid #ccc; 
    padding: 10px; 
    background-color: #f9f9f9; 
    font-family: monospace;
  }
    /* Estilo para o Símbolo da PUC Campinas */
  .logo-puc {
      position: absolute; 
      top: 10px; 
      right: 10px; 
      max-width: 100px; 
      height: auto;
  }
</style>
</head>
<body>
  
  <img src="data:image/png;base64," alt="Símbolo da PUC Campinas" class="logo-puc">		
  <h2>Simulador - Tela de Entrada (ESP32 Web)</h2>
  <p>Utilize de seu crachá ou do usuário de Administrador para sua autenticação. A sessão expira após cada envio.</p>
  
  <div class="button-group">
    <button id="simulateBtn">Simular RFID (gera UID aleatório)</button>
    <button id="simulateCustom">Simular com UID customizado</button>
    <button id="generatePdfBtn" style="background-color: #f44336; color: white;">Gerar PDF dos Registros</button>
  </div>
  
  <div class="login-form">
    <h3>Login Manual</h3>
    <form id="loginForm" onsubmit="authenticateManual(event)">
        <label>Usuário:
            <input type="text" id="username" required placeholder="Digite o usuário">
        </label>
        <label>Senha:
            <input type="password" id="password" required placeholder="Digite a senha">
        </label>
        <button type="submit">Autenticar</button>
        <div id="loginStatus" class="login-status"></div>
    </form>
  </div>
  <div id="status" class="status" style="margin-top: 20px;">Aguardando RFID/Login...</div>

  <form id="myForm" class="locked" onsubmit="submitForm(event)">
    <div class="form-group-row-center">
        <div>
            <label for="id_bomba">Identificação da Bomba:</label>
            <input type="text" id="id_bomba" name="identificacao_bomba" required>
        </div>
    </div>

    <fieldset>
        <legend>Estado da Bomba</legend>
        
        <div class="radio-group">
            <div>
                <input type="radio" id="inicio" name="estado_bomba" value="inicio" required>
                <label for="inicio">Início</label>
            </div>
            
            <div>
                <input type="radio" id="pausa" name="estado_bomba" value="pausada">
                <label for="pausada">Pausada</label>
            </div>
        </div>
    </fieldset>
    
    <div class="form-group-triple">
        <div>
            <label for="nome">Nome do paciente:</label>
            <input type="text" id="nome" required placeholder="Identificação do paciente">
        </div>
        
        <div>
            <label for="valor">Valor pré programado:</label>
            <div class="input-with-label">
                <input type="text" id="valor" required placeholder="Digite um valor">
                <span>mL</span>
            </div>
        </div>
        
        <div>
            <label for="opcao">Motivos de pausa:</label>
            <select id="opcao">
                <option value="JC">JC - Jejum para cirurgia</option>
                <option value="JE">JE - Jejum para exame</option>
                <option value="JEXT">JEXT - Jejum para extubação</option>
                <option value="Banho">Banho</option>
                <option value="Transferencia">Transferência (de leito/setor)</option>
                <option value="Medicacao">Medicação</option>
                <option value="SNE">Perda de SNE</option>
                <option value="TGI">TGI: Vômito, Diarreia, Distensão abdominal</option>
                <option value="IC">IC - Instabilidade Clínica</option>
		<option value="Reinicio da bomba">Reinicio da bomba
            </select>
        </div>
    </div>

    <div class="form-group-single">
        <label for="comentario">Observação/Comentário:</label>
        <input type="text" id="comentario" placeholder="Adicione uma nota (opcional)">
    </div>

    <div class="form-group-single">
        <label for="leito">Leito do Paciente:</label>
        <input type="text" id="leito" required placeholder="Ex: CTI 10A">
    </div>
        
    <button type="submit">Enviar</button>
  </form>

  <div class="log-container">
      <h3>Registro de Atividades (Logs)</h3>
      <div id="log-output">
          Carregando logs do servidor...
      </div>
      <p style="font-size: 12px; color: #666; margin-top: 5px;">Atualização automática a cada 3 segundos. Dados persistem no servidor.</p>
  </div>

<script>
const { jsPDF } = window.jspdf;

let authenticated = false;
let uid = '';
let authUntil = 0;
// 🚀 ALTERAÇÃO AQUI: 90000 milissegundos = 90 segundos (1 minuto e meio)
const AUTH_TIMEOUT = 90000; 
const ADMIN_UID = 'ADMIN_LOGIN';

// Credenciais Estáticas
const ADMIN_USER = 'Administrador';
const ADMIN_PASS = 'puccampinas';


function updateUI(){
  const status = document.getElementById('status');
  const form = document.getElementById('myForm');
  const loginFormDiv = document.querySelector('.login-form');
  const loginStatus = document.getElementById('loginStatus');

  if(authenticated && Date.now() < authUntil){
    let expiryMsg = (uid !== ADMIN_UID) ? `(expira em ${Math.ceil((authUntil-Date.now())/1000)}s)` : '(Autenticação Manual)';
    status.textContent = `Autenticado! UID: ${uid} ${expiryMsg}`;
    form.classList.remove('locked');
    loginFormDiv.style.display = 'none';
    loginStatus.textContent = '';
  } else {
    status.textContent = 'Aguardando RFID/Login...';
    form.classList.add('locked');
    loginFormDiv.style.display = 'block';
    authenticated = false;
    uid = '';
  }
}

// ----------------------------------------------------
// Função de Autenticação Manual
// ----------------------------------------------------
function authenticateManual(ev) {
    ev.preventDefault();
    const user = document.getElementById('username').value;
    const pass = document.getElementById('password').value;
    const loginStatus = document.getElementById('loginStatus');

    if (user === ADMIN_USER && pass === ADMIN_PASS) {
        uid = ADMIN_UID;
        authenticated = true;
        // Sessão do administrador não expira por tempo, mas será encerrada após o envio
        authUntil = Date.now() + AUTH_TIMEOUT; // Usa AUTH_TIMEOUT, que é 90000
        updateUI();
        document.getElementById('password').value = '';
    } else {
        loginStatus.textContent = 'Usuário ou senha incorretos.';
    }
}

// ----------------------------------------------------
// RFID: Funções de Simulação
// ----------------------------------------------------
function simulateRandom(){
  const r = Math.floor(Math.random()*0xFFFFFF).toString(16).toUpperCase().padStart(6,'0');
  simulateUID(r);
}

function simulateUID(u){
  uid = u;
  authenticated = true;
  authUntil = Date.now() + AUTH_TIMEOUT;
  updateUI();
  
  const iv = setInterval(()=>{
    if(!authenticated || Date.now() > authUntil){
      clearInterval(iv);
      updateUI();
    } else updateUI();
  }, 500);
}

// ----------------------------------------------------
// Funções de Envio e PDF
// ----------------------------------------------------
async function submitForm(ev){
  ev.preventDefault();
  
  // Confirmação simples de que o formulário está ativo
  if (!authenticated) {
      alert("Erro: Formulário não está autenticado. Por favor, autentique-se novamente.");
      return;
  }
  
  const data = {
    id_bomba: document.getElementById('id_bomba').value,
    estado_bomba: document.querySelector('input[name="estado_bomba"]:checked').value,
    // 💡 ALTERAÇÃO AQUI: Renomeando o campo para 'nome_do_paciente' no JSON de envio
    nome_do_paciente: document.getElementById('nome').value, 
    valor_ml: document.getElementById('valor').value,
    motivo_pausa: document.getElementById('opcao').value,
    comentario: document.getElementById('comentario').value, 
    leito: document.getElementById('leito').value, 
    uid_origem: uid || 'N/A'
  };
  
  // NOVO: Enviar dados para o endpoint /enviar do servidor Flask
  try {
    const response = await fetch('/enviar', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
    });

    const result = await response.json();
    
    if (response.ok) {
        alert('Servidor recebeu e salvou os dados com sucesso!');
        // Força a atualização dos logs logo após o envio
        fetchLogs(); 
    } else {
        alert('Erro ao enviar dados para o servidor: ' + (result.mensagem || response.statusText));
    }
    
  } catch (error) {
    alert('Erro de conexão com o servidor Flask: Verifique se o server.py está rodando.');
    console.error('Erro de envio:', error);
  }

  // Limpar campos
  document.getElementById('id_bomba').value = '';
  document.getElementById('nome').value = '';
  document.getElementById('valor').value = '';
  document.getElementById('comentario').value = ''; 
  document.getElementById('leito').value = ''; 
  
  // ===================================================================
  // SEGURANÇA: ENCERRA A SESSÃO APÓS O ENVIO (Logout)
  // ===================================================================
  // Invalida a sessão forçando a expiração.
  authUntil = Date.now();
  authenticated = false;
  
  // Atualiza a interface para bloquear o formulário imediatamente
  updateUI(); 
}

function generatePDF() {
    const logsElement = document.getElementById('log-output'); 
    const logsText = logsElement.textContent;
    
    if (logsText.includes('Nenhum registro encontrado') || logsText.includes('Carregando logs') || logsText.length < 50) {
        alert('Aguarde os logs serem carregados ou envie um formulário.');
        return;
    }

    const doc = new jsPDF();
    const pageWidth = doc.internal.pageSize.getWidth();
    const margin = 15;
    let y = margin;
    const lineHeight = 10;
    
    doc.setFontSize(16);
    doc.text("Relatório de Registros do Simulador ESP32", pageWidth / 2, y, { align: 'center' });
    y += lineHeight * 2;

    doc.setFontSize(10);
    doc.setFont(undefined, 'normal');
    
    const lines = doc.splitTextToSize(logsText, pageWidth - 2 * margin);
    
    lines.forEach(line => {
        if (y > doc.internal.pageSize.getHeight() - margin) {
            doc.addPage();
            y = margin;
        }
        doc.text(line, margin, y);
        y += lineHeight * 0.7;
    });

    const timestamp = new Date().toISOString().replace(/[:.]/g, "-");
    doc.save(`relatorio_logs_${timestamp}.pdf`);
}

// ----------------------------------------------------
// FUNÇÕES DE BUSCA DE LOGS
// ----------------------------------------------------
function fetchLogs() {
    fetch('/logs')
        .then(response => {
            if (!response.ok) {
                throw new Error('Erro ao buscar logs: ' + response.status);
            }
            return response.json();
        })
        .then(logs => {
            const logOutput = document.getElementById('log-output');
            
            // Mapeia a lista de strings de log para elementos HTML
            let logHTML = logs.map(log => {
                return `<p style="margin: 2px 0; font-size: 13px; color: #333;">${log}</p>`;
            }).join('');
            
            // Atualiza o container de logs
            logOutput.innerHTML = logHTML || '<p style="color: #888;">Nenhum registro encontrado.</p>';
        })
        .catch(error => {
            console.error('Erro de rede/servidor ao buscar logs:', error);
            document.getElementById('log-output').innerHTML = `<p style="color: red; font-weight: bold;">[ERRO] Não foi possível conectar ao servidor /logs. Verifique se o server.py está rodando corretamente.</p>`;
        });
}


// Event Listeners
document.getElementById('simulateBtn').addEventListener('click', simulateRandom);
document.getElementById('simulateCustom').addEventListener('click', ()=>{
  const u = prompt('Digite o UID a simular (ex: ABCD1234):','ABCD1234');
  if(u) simulateUID(u);
});
document.getElementById('generatePdfBtn').addEventListener('click', generatePDF);


// Inicialização e Atualização Periódica
updateUI();
fetchLogs(); // Inicia a busca imediatamente
setInterval(fetchLogs, 3000); // Atualiza a cada 3 segundos
</body>
</html>
